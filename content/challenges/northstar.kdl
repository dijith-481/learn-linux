// Northstar Relay: 54 snapshots of one escalating recovery story.
// Each lesson is a fresh virtual home; the numbered missions preserve the narrative.
// Every canonical solution is exercised by `learn content simulate --all`.

challenge "relay.01" version=1 {
    title "The First Message"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        teaches "relay.step.01"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cat"
        }
    }
    objective {
        text "The Northstar relay has gone quiet. Read the welcome message in welcome.txt."
    }
    setup {
        write "~/welcome.txt" {
            text "Northstar relay: night shift begins.\n"
        }
    }
    verify {
        all {
            file-read "~/welcome.txt" "Northstar relay: night shift begins."
        }
    }
    hints {
        hint level=1 {
            text "The message is already in a file. You only need to display it."
        }
        hint level=2 {
            text "Look for the FILE argument. Run man cat or cat --help for syntax."
        }
    }
    solution {
        concept "cat sends a file's contents to the terminal."
        command "cat ~/welcome.txt"
    }
}

challenge "relay.02" version=1 {
    title "Find the Console"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.01"
        teaches "relay.step.02"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cd"
        }
    }
    objective {
        text "Move into the console folder where the relay controls are kept."
    }
    setup {
        mkdir "~/console"
    }
    verify {
        all {
            cwd "~/console"
        }
    }
    hints {
        hint level=1 {
            text "Moving between folders changes your current working directory."
        }
        hint level=2 {
            text "The console folder is inside your home. Run man cd or cd --help for syntax."
        }
    }
    solution {
        concept "cd changes the shell's current directory."
        command "cd ~/console"
    }
}

challenge "relay.03" version=1 {
    title "Make an Inbox"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.02"
        teaches "relay.step.03"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "mkdir"
        }
    }
    objective {
        text "Create an inbox folder in your home for incoming shift notes."
    }
    verify {
        all {
            file-exists "~/inbox"
        }
    }
    hints {
        hint level=1 {
            text "You need a folder, not a file."
        }
        hint level=2 {
            text "Give mkdir the new folder's path. Run man mkdir or mkdir --help for syntax."
        }
    }
    solution {
        concept "mkdir creates a directory at the path you name."
        command "mkdir ~/inbox"
    }
}

challenge "relay.04" version=1 {
    title "Open a Shift Log"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.03"
        teaches "relay.step.04"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "touch"
        }
    }
    objective {
        text "Create an empty file named shift.txt inside the inbox folder."
    }
    setup {
        mkdir "~/inbox"
    }
    verify {
        all {
            file-equals "~/inbox/shift.txt" ""
        }
    }
    hints {
        hint level=1 {
            text "The inbox exists already; add an empty file inside it."
        }
        hint level=2 {
            text "The full path includes both inbox and shift.txt. Run man touch or touch --help for syntax."
        }
    }
    solution {
        concept "touch creates an empty file without writing text."
        command "touch ~/inbox/shift.txt"
    }
}

challenge "relay.05" version=1 {
    title "Mark the Console Ready"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.04"
        teaches "relay.step.05"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "printf"
        }
    }
    objective {
        text "Save the word ready in a new file named status.txt in your home."
    }
    verify {
        all {
            file-equals "~/status.txt" "ready"
        }
    }
    hints {
        hint level=1 {
            text "Produce the word, then send it into a file."
        }
        hint level=2 {
            text "The > operator saves output instead of printing it. Run man printf or printf --help for syntax."
        }
    }
    solution {
        concept "Redirection writes command output into a file."
        command "printf ready > ~/status.txt"
    }
}

challenge "relay.06" version=1 {
    title "Read the Handoff"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.05"
        teaches "relay.step.06"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cat"
        }
    }
    objective {
        text "Read handoff.txt to learn what the previous operator found."
    }
    setup {
        write "~/handoff.txt" {
            text "Power is stable. The antenna is not.\n"
        }
    }
    verify {
        all {
            file-read "~/handoff.txt" "The antenna is not."
        }
    }
    hints {
        hint level=1 {
            text "The handoff already exists. Reading it is the goal."
        }
        hint level=2 {
            text "Point cat at handoff.txt. Run man cat or cat --help for syntax."
        }
    }
    solution {
        concept "Reading a file reveals information without changing it."
        command "cat ~/handoff.txt"
    }
}

challenge "relay.07" version=1 {
    title "Keep a Spare Map"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.06"
        teaches "relay.step.07"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cp"
        }
    }
    objective {
        text "Copy map.txt into the backup folder, keeping the original in place."
    }
    setup {
        mkdir "~/backup"
        write "~/map.txt" {
            text "antenna -> ridge\n"
        }
    }
    verify {
        all {
            file-equals "~/backup/map.txt" "antenna -> ridge\n"
            file-equals "~/map.txt" "antenna -> ridge\n"
        }
    }
    hints {
        hint level=1 {
            text "This needs a copy: the original map must remain."
        }
        hint level=2 {
            text "The source comes first and the backup folder second. Run man cp or cp --help for syntax."
        }
    }
    solution {
        concept "cp makes another file without removing the source."
        command "cp ~/map.txt ~/backup/"
    }
}

challenge "relay.08" version=1 {
    title "Correct the Label"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.07"
        teaches "relay.step.08"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "mv"
        }
    }
    objective {
        text "Rename misnamed.txt to antenna.txt so the crew can find it."
    }
    setup {
        write "~/misnamed.txt" {
            text "ridge antenna\n"
        }
    }
    verify {
        all {
            file-equals "~/antenna.txt" "ridge antenna\n"
            file-missing "~/misnamed.txt"
        }
    }
    hints {
        hint level=1 {
            text "A move can also give one file a new name."
        }
        hint level=2 {
            text "Put the old name first and the new name second. Run man mv or mv --help for syntax."
        }
    }
    solution {
        concept "mv changes a file's path or name."
        command "mv ~/misnamed.txt ~/antenna.txt"
    }
}

challenge "relay.09" version=1 {
    title "Clear the Desk"
    summary "First Shift — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 3
    skills {
        requires "relay.step.08"
        teaches "relay.step.09"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "rm"
            allow "touch"
        }
    }
    objective {
        text "Remove stale.txt, then create an empty ready.txt in the inbox."
    }
    setup {
        mkdir "~/inbox"
        write "~/stale.txt" {
            text "old note"
        }
    }
    verify {
        all {
            file-missing "~/stale.txt"
            file-equals "~/inbox/ready.txt" ""
        }
    }
    hints {
        hint level=1 {
            text "This is two separate actions: discard one file and create another."
        }
        hint level=2 {
            text "Check the filename carefully before removing it. Run man rm or rm --help for syntax."
        }
    }
    solution {
        concept "Small shell tasks often combine safe removal with creation."
        command "rm ~/stale.txt"
        command "touch ~/inbox/ready.txt"
    }
}

challenge "relay.10" version=1 {
    title "Build the Feed Path"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.09"
        teaches "relay.step.10"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "mkdir"
        }
    }
    objective {
        text "Create the nested folders relay/feeds/night in your home."
    }
    verify {
        all {
            file-exists "~/relay/feeds/night"
        }
    }
    hints {
        hint level=1 {
            text "The parent folders do not exist yet."
        }
        hint level=2 {
            text "The -p option builds missing parents in one command. Run man mkdir or mkdir --help for syntax."
        }
    }
    solution {
        concept "mkdir -p creates an entire missing directory path."
        command "mkdir -p ~/relay/feeds/night"
    }
}

challenge "relay.11" version=1 {
    title "Enter the Feed Room"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.10"
        teaches "relay.step.11"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cd"
        }
    }
    objective {
        text "Move into relay/feeds/night so commands run from the feed room."
    }
    setup {
        mkdir "~/relay"
        mkdir "~/relay/feeds"
        mkdir "~/relay/feeds/night"
    }
    verify {
        all {
            cwd "~/relay/feeds/night"
        }
    }
    hints {
        hint level=1 {
            text "The nested folders are already present."
        }
        hint level=2 {
            text "You can use a path starting with ~/ from any location. Run man cd or cd --help for syntax."
        }
    }
    solution {
        concept "A path beginning with ~ starts at your home."
        command "cd ~/relay/feeds/night"
    }
}

challenge "relay.12" version=1 {
    title "Three Empty Channels"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.11"
        teaches "relay.step.12"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "touch"
        }
    }
    objective {
        text "Create empty channel1.txt, channel2.txt, and channel3.txt in signals."
    }
    setup {
        mkdir "~/signals"
    }
    verify {
        all {
            file-equals "~/signals/channel1.txt" ""
            file-equals "~/signals/channel2.txt" ""
            file-equals "~/signals/channel3.txt" ""
        }
    }
    hints {
        hint level=1 {
            text "The files share the same name except for their number."
        }
        hint level=2 {
            text "The shell expands {1..3} into three numbers. Run man touch or touch --help for syntax."
        }
    }
    solution {
        concept "Brace expansion generates several filenames before touch runs."
        command "touch ~/signals/channel{1..3}.txt"
    }
}

challenge "relay.13" version=1 {
    title "Copy a Signal Sample"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.12"
        teaches "relay.step.13"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cp"
        }
    }
    objective {
        text "Copy sample.txt into the review folder without deleting the source."
    }
    setup {
        mkdir "~/review"
        write "~/sample.txt" {
            text "signal 42\n"
        }
    }
    verify {
        all {
            file-equals "~/review/sample.txt" "signal 42\n"
            file-equals "~/sample.txt" "signal 42\n"
        }
    }
    hints {
        hint level=1 {
            text "The review folder already exists; keep the original."
        }
        hint level=2 {
            text "A trailing slash makes the folder destination clear. Run man cp or cp --help for syntax."
        }
    }
    solution {
        concept "Copying leaves the source untouched."
        command "cp ~/sample.txt ~/review/"
    }
}

challenge "relay.14" version=1 {
    title "Gather the Logs"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.13"
        teaches "relay.step.14"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cp"
        }
    }
    objective {
        text "Copy every .log file from feeds to backup, but leave readme.txt behind."
    }
    setup {
        mkdir "~/backup"
        mkdir "~/feeds"
        write "~/feeds/a.log" {
            text "A\n"
        }
        write "~/feeds/b.log" {
            text "B\n"
        }
        write "~/feeds/readme.txt" {
            text "notes\n"
        }
    }
    verify {
        all {
            file-equals "~/backup/a.log" "A\n"
            file-equals "~/backup/b.log" "B\n"
            file-missing "~/backup/readme.txt"
        }
    }
    hints {
        hint level=1 {
            text "The files you want share one extension."
        }
        hint level=2 {
            text "*.log matches any filename ending in .log. Run man cp or cp --help for syntax."
        }
    }
    solution {
        concept "A glob lets one command act on a family of files."
        command "cp ~/feeds/*.log ~/backup/"
    }
}

challenge "relay.15" version=1 {
    title "Move the Crate"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.14"
        teaches "relay.step.15"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "mv"
        }
    }
    objective {
        text "Move the parts folder and everything inside it into storage."
    }
    setup {
        mkdir "~/parts"
        mkdir "~/storage"
        write "~/parts/fuse.txt" {
            text "spare\n"
        }
    }
    verify {
        all {
            file-equals "~/storage/parts/fuse.txt" "spare\n"
            file-missing "~/parts"
        }
    }
    hints {
        hint level=1 {
            text "Moving a folder also moves its contents."
        }
        hint level=2 {
            text "Use storage as the destination folder. Run man mv or mv --help for syntax."
        }
    }
    solution {
        concept "mv can relocate a directory tree."
        command "mv ~/parts ~/storage/"
    }
}

challenge "relay.16" version=1 {
    title "Discard a Bad Reading"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.15"
        teaches "relay.step.16"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "rm"
        }
    }
    objective {
        text "Remove bad.txt from samples while keeping good.txt."
    }
    setup {
        mkdir "~/samples"
        write "~/samples/bad.txt" {
            text "noise\n"
        }
        write "~/samples/good.txt" {
            text "steady\n"
        }
    }
    verify {
        all {
            file-missing "~/samples/bad.txt"
            file-equals "~/samples/good.txt" "steady\n"
        }
    }
    hints {
        hint level=1 {
            text "Only one sample is wrong."
        }
        hint level=2 {
            text "Name bad.txt exactly; good.txt must remain. Run man rm or rm --help for syntax."
        }
    }
    solution {
        concept "Removal is precise when you name a single file."
        command "rm ~/samples/bad.txt"
    }
}

challenge "relay.17" version=1 {
    title "Locate the Beacon"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.16"
        teaches "relay.step.17"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cat"
            allow "find"
        }
    }
    objective {
        text "Find beacon.txt somewhere under archive, then read its message."
    }
    setup {
        mkdir "~/archive"
        mkdir "~/archive/2025"
        mkdir "~/archive/2026"
        mkdir "~/archive/old"
        mkdir "~/archive/2026/ridge"
        write "~/archive/old/map.txt" {
            text "map\n"
        }
        write "~/archive/2026/ridge/beacon.txt" {
            text "Beacon at ridge 7.\n"
        }
        write "~/archive/2025/beacon.log" {
            text "old\n"
        }
    }
    verify {
        all {
            file-read "~/archive/2026/ridge/beacon.txt" "Beacon at ridge 7."
        }
    }
    hints {
        hint level=1 {
            text "The name is known, but the folder is not."
        }
        hint level=2 {
            text "Search archive by the exact filename, then read the result. Run man find or find --help for syntax."
        }
    }
    solution {
        concept "find locates a path; cat opens the file it found."
        command "find ~/archive -name beacon.txt"
        command "cat ~/archive/2026/ridge/beacon.txt"
    }
}

challenge "relay.18" version=1 {
    title "Tidy the Workbench"
    summary "Finding Signal — repair the Northstar relay."
    difficulty "beginner"
    estimated-minutes 4
    skills {
        requires "relay.step.17"
        teaches "relay.step.18"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "mv"
            allow "rm"
        }
    }
    objective {
        text "Move draft.txt into finished, then remove the empty scratch note."
    }
    setup {
        mkdir "~/finished"
        write "~/draft.txt" {
            text "checked\n"
        }
        write "~/scratch.txt" {
            text ""
        }
    }
    verify {
        all {
            file-equals "~/finished/draft.txt" "checked\n"
            file-missing "~/draft.txt"
            file-missing "~/scratch.txt"
        }
    }
    hints {
        hint level=1 {
            text "One file should be kept in a new place; the other should go."
        }
        hint level=2 {
            text "Finish the move before removing scratch.txt. Run man mv or mv --help for syntax."
        }
    }
    solution {
        concept "Combining move and remove keeps useful work while clearing clutter."
        command "mv ~/draft.txt ~/finished/"
        command "rm ~/scratch.txt"
    }
}

challenge "relay.19" version=1 {
    title "Spot the Alarm"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
        requires "relay.step.18"
        teaches "relay.step.19"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "grep"
        }
    }
    objective {
        text "Save the line containing ALERT from radio.log into alarm.txt."
    }
    setup {
        write "~/radio.log" {
            text "INFO link up\nALERT weak signal\nINFO retry\n"
        }
    }
    verify {
        all {
            file-equals "~/alarm.txt" "ALERT weak signal\n"
        }
    }
    hints {
        hint level=1 {
            text "Search the log for one word rather than reading every line."
        }
        hint level=2 {
            text "Send grep's matching line to alarm.txt with >. Run man grep or grep --help for syntax."
        }
    }
    solution {
        concept "grep filters input lines by text."
        command "grep ALERT ~/radio.log > ~/alarm.txt"
    }
}

challenge "relay.20" version=1 {
    title "Read the Beginning"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
        requires "relay.step.19"
        teaches "relay.step.20"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "head"
        }
    }
    objective {
        text "Save the first ten lines of a twelve-line boot log in start.txt."
    }
    setup {
        write "~/boot.log" {
            text "L01\nL02\nL03\nL04\nL05\nL06\nL07\nL08\nL09\nL10\nL11\nL12\n"
        }
    }
    verify {
        all {
            file-equals "~/start.txt" "L01\nL02\nL03\nL04\nL05\nL06\nL07\nL08\nL09\nL10\n"
        }
    }
    hints {
        hint level=1 {
            text "The beginning of the log is what matters."
        }
        hint level=2 {
            text "This shell's head prints ten lines. Run man head or head --help for syntax."
        }
    }
    solution {
        concept "head takes the first ten lines of a file or stream."
        command "head ~/boot.log > ~/start.txt"
    }
}

challenge "relay.21" version=1 {
    title "Read the End"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
        requires "relay.step.20"
        teaches "relay.step.21"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "tail"
        }
    }
    objective {
        text "Save the last ten lines of a twelve-line boot log in end.txt."
    }
    setup {
        write "~/boot.log" {
            text "L01\nL02\nL03\nL04\nL05\nL06\nL07\nL08\nL09\nL10\nL11\nL12\n"
        }
    }
    verify {
        all {
            file-equals "~/end.txt" "L03\nL04\nL05\nL06\nL07\nL08\nL09\nL10\nL11\nL12\n"
        }
    }
    hints {
        hint level=1 {
            text "The newest entries are at the end."
        }
        hint level=2 {
            text "This shell's tail prints the final ten lines. Run man tail or tail --help for syntax."
        }
    }
    solution {
        concept "tail keeps the last ten lines of a file or stream."
        command "tail ~/boot.log > ~/end.txt"
    }
}

challenge "relay.22" version=1 {
    title "Add a Repair Note"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
        requires "relay.step.21"
        teaches "relay.step.22"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "echo"
        }
    }
    objective {
        text "Append repaired to the existing maintenance log without erasing its first line."
    }
    setup {
        write "~/maintenance.log" {
            text "checked\n"
        }
    }
    verify {
        all {
            file-equals "~/maintenance.log" "checked\nrepaired\n"
        }
    }
    hints {
        hint level=1 {
            text "The old entry must remain."
        }
        hint level=2 {
            text "Use >> to append, not > to replace. Run man echo or echo --help for syntax."
        }
    }
    solution {
        concept "Append redirection adds output after existing contents."
        command "echo repaired >> ~/maintenance.log"
    }
}

challenge "relay.23" version=1 {
    title "Pass the Message Along"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
        requires "relay.step.22"
        teaches "relay.step.23"
    }
    state "ephemeral"
    shell "bash"
    capabilities {
        network "none"
        tools {
            allow "cat"
            allow "grep"
        }
    }
    objective {
        text "Read chatter.txt, keep only the READY line, and save it in ready.txt."
    }
    setup {
        write "~/chatter.txt" {
            text "WAIT\nREADY antenna\nNOISE\n"
        }
    }
    verify {
        all {
            file-equals "~/ready.txt" "READY antenna\n"
        }
    }
    hints {
        hint level=1 {
            text "One tool reads the file; another keeps the line you need."
        }
        hint level=2 {
            text "A pipe joins their output and input; > saves the result. Run man grep or grep --help for syntax."
        }
    }
    solution {
        concept "Pipes compose simple commands into a useful chain."
        command "cat ~/chatter.txt | grep READY > ~/ready.txt"
    }
}

challenge "relay.24" version=1 {
    title "Measure a Signal"
    summary "Sorting Noise — repair the Northstar relay."
    difficulty "intermediate"
    estimated-minutes 5
    skills {
